# Equivalent to Nginx Proxy Manager's Proxy Host settings.
# Replace 192.168.1.50 with the Docker host's LAN IP.
server {
    listen 80;
    server_name unicorntunes.nate;
    location / {
        proxy_pass http://192.168.1.50:8863;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
