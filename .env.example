# Client ID is the public app identifier; no Spotify client secret is needed.
SPOTIFY_CLIENT_ID=replace_with_your_32_character_client_id
FOXTUNES_IMAGE=ghcr.io/natsteff/foxtunes:0.1.3
# Match the browser's exact origin. Use https only after certificate trust works.
FOXTUNES_PUBLIC_URL=http://foxtunes.nate
# If Nginx Proxy Manager is on another host/container, set this to the Docker
# host's specific LAN IP. Default is reachable only by a host-local proxy.
FOXTUNES_BIND_IP=127.0.0.1
FOXTUNES_PORT=8863
